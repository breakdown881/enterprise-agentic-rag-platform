# Application Settings
ENVIRONMENT=development
APP_NAME=Enterprise Agentic Knowledge Platform
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=["*"]

# Server Port
API_PORT=8000

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/enterprise_rag

# Redis (Semantic Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.94
CACHE_TTL_SECONDS=86400

# LLM Providers (LiteLLM / Direct API)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
DEFAULT_CHAT_MODEL=gpt-4o
DEFAULT_FAST_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Anthropic / Secondary Providers (Optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# LLMOps & Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# RAG & Ingestion Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
RERANKER_MODEL=BAAI/bge-reranker-large
